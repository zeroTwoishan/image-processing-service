# Copy this file to .env and fill it in. Never commit .env.

PORT=4000
MONGO_URI=mongodb://localhost:27017/image-processing

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Where image URLs point. /uploads works in dev (Vite proxies it to the API); with s3 it's the bucket's public URL.
PUBLIC_ASSET_BASE=/uploads
# Hours until an upload (and its versions) is hidden and then deleted.
IMAGE_TTL_HOURS=12
# Local storage folder, relative to server/.
UPLOAD_DIR=uploads

# Where files are stored: local (this disk) or s3 (an S3-compatible bucket; we use Supabase Storage). With s3,
# all five S3_* values are required and PUBLIC_ASSET_BASE must be the bucket's public URL:
#   https://<project ref>.supabase.co/storage/v1/object/public/<bucket>
STORAGE_DRIVER=local
# Supabase → Project Settings → Storage → S3 connection. The key pair is a secret: never commit or share it.
# S3_ENDPOINT=https://<project ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-south-1
# S3_BUCKET=images
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Production only (required there): the client's address, e.g. https://your-app.vercel.app. Only that site's
# JavaScript may call the API from another origin. Leave unset in dev.
# CLIENT_ORIGIN=

# Optional. bcrypt work factor (default 12); each +1 doubles login/register time. Leave it unset.
# BCRYPT_COST=12
